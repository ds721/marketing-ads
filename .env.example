# ── Database ─────────────────────────────────────────────────────────────
# Any PostgreSQL works. Local Postgres.app example:
DATABASE_URL="postgresql://USER@localhost:5431/markit_dev"
# Supabase example (Settings → Database → Connection string, use the
# "Transaction" pooler URL for the app and the direct URL for migrations):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional Google OAuth (login shows the button only when configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Encryption ───────────────────────────────────────────────────────────
# 32-byte hex key for encrypting social OAuth tokens at rest.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=""

# ── AI providers ─────────────────────────────────────────────────────────
# AI_PROVIDER: "openai" (production) | "mock" (dev only — clearly labelled in UI)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ── File storage ─────────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (dev, ./storage dir) | "s3" (production)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Email ────────────────────────────────────────────────────────────────
# EMAIL_DRIVER: "console" (dev — prints links to server log) | "smtp"
EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Markit <hello@example.com>"

# ── Social OAuth ─────────────────────────────────────────────────────────
# Instagram + Facebook both connect through one Meta app. See README →
# "Connecting Instagram". The Connect button stays disabled until both are set.
# Redirect URI to register in the Meta app: {APPLICATION_URL}/api/social/meta/callback
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Payments (billing is architecture-ready; not wired to a provider) ────
PAYMENT_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# ── App ──────────────────────────────────────────────────────────────────
APPLICATION_URL="http://localhost:3000"
# Enable the in-process background job worker in dev
JOBS_ENABLED="true"
