# ── Database ─────────────────────────────────────────────────────────────
# Any PostgreSQL works.
# Local (Postgres.app): both URLs are the same.
DATABASE_URL="postgresql://USER@localhost:5431/markit_dev"
DIRECT_URL="postgresql://USER@localhost:5431/markit_dev"
# Hosted (Supabase / Neon): DATABASE_URL is the POOLED url, DIRECT_URL the direct
# one — serverless needs pooling, migrations need a direct connection.
# DATABASE_URL="postgresql://…@…pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://…@…pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
# Optional Google sign-in (the button appears only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Encryption ───────────────────────────────────────────────────────────
# 32-byte hex, encrypts social tokens at rest. openssl rand -hex 32
# Changing this makes existing Instagram connections unreadable.
APP_ENCRYPTION_KEY=""

# ── AI ───────────────────────────────────────────────────────────────────
# "gemini" | "openai" for real generation, "mock" for the labelled stub.
AI_PROVIDER="mock"

# Gemini has a free tier and asks for no card — get a key in one click at
# https://aistudio.google.com/apikey. Free means rate-limited, not unlimited.
GEMINI_API_KEY=""

# OpenAI is pay-as-you-go: a key alone is not enough, the account needs
# credit on it (https://platform.openai.com/settings/organization/billing).
OPENAI_API_KEY=""

# Optional per-task model overrides
# AI_MODEL_STRATEGY="gpt-4o"
# AI_MODEL_IMAGE="gpt-image-1"
# AI_MODEL_IMAGE_GEMINI="gemini-2.5-flash-image"

# ── File storage ─────────────────────────────────────────────────────────
# "local" (./storage, development only — serverless filesystems are read-only)
# "blob"  (Vercel Blob; BLOB_READ_WRITE_TOKEN is set automatically by Vercel)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ── Instagram (Instagram Login — no Facebook Page needed) ────────────────
# From your Meta app → Instagram → API setup with Instagram login.
# Use the *Instagram* app ID/secret shown there, not the Facebook ones.
# Register these redirect URIs there:
#   {APPLICATION_URL}/api/social/instagram/callback
#   {APPLICATION_URL}/api/social/instagram/deauthorize
#   {APPLICATION_URL}/api/social/instagram/data-deletion
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# ── Email ────────────────────────────────────────────────────────────────
# "console" prints verification/reset links to the server log (development).
EMAIL_DRIVER="console"
EMAIL_FROM="Markit <hello@example.com>"

# ── Background jobs ──────────────────────────────────────────────────────
# Local: "true" runs the worker inside the dev server.
# Vercel: leave unset — vercel.json drives /api/jobs/tick on a cron, and
# CRON_SECRET (set it in the Vercel dashboard) protects the endpoint.
JOBS_ENABLED="true"
CRON_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────
# The public address. Must match what you register with Meta, exactly.
APPLICATION_URL="http://localhost:3000"

# ── Later ────────────────────────────────────────────────────────────────
# ffmpeg (video watermarks/posters) is a host binary, not an env var.
# Payments are not wired to a provider yet.
